<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Assitech.App.NewTicketPage" Title="Nouveau ticket">
<VerticalStackLayout Padding="24" Spacing="12">
<Entry x:Name="Sujet" Placeholder="Entrez le sujet" TextChanged="OnChanged"/>
<Editor x:Name="Desc" Placeholder="Décrivez votre problème en détail" HeightRequest="140" TextChanged="OnChanged"/>
<Button x:Name="Go" Text="Créer" IsEnabled="False" Clicked="OnCreate"/>
</VerticalStackLayout></ContentPage>
